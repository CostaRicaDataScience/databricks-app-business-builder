# Environment for Databricks App business builder
LOG_LEVEL=info
DATABRICKS_HOST=https://example.databricks.com
DATABRICKS_TOKEN=
# Alternative to host+token in user_workspace mode (a ~/.databrickscfg profile)
DATABRICKS_CONFIG_PROFILE=
DBX_AUTH_MODE=user_workspace
DBX_SP_CLIENT_ID=
DBX_SP_CLIENT_SECRET=
FOUNDATION_MODEL_PROVIDER=databricks_foundation_model_apis
FOUNDATION_MODEL_ENDPOINT=databricks-claude-sonnet
PREFERRED_MODEL=claude
FALLBACK_MODEL=databricks-gpt-fallback
APPGEN_DIR=.appgen
OUTPUT_ROOT=./generated_apps
DRY_RUN_DEFAULT=true

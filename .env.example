# Environment for Databricks App business builder
LOG_LEVEL=info
DATABRICKS_HOST=https://example.databricks.com
DATABRICKS_TOKEN=
# Alternative to host+token in user_workspace mode (a ~/.databrickscfg profile)
DATABRICKS_CONFIG_PROFILE=
DBX_AUTH_MODE=user_workspace
DBX_SP_CLIENT_ID=
DBX_SP_CLIENT_SECRET=

# --- Databricks Apps OBO (on-behalf-of-user) ---
# When deployed as a Databricks App with *user authorization* enabled, the
# platform forwards the signed-in user's identity and OAuth token on every
# request as HTTP headers (no env vars needed):
#   X-Forwarded-Access-Token  -> per-request OBO user token
#   X-Forwarded-Email / X-Forwarded-User -> user identity
# The app builds a per-request WorkspaceClient from that token so all Databricks
# calls run with the user's real permissions. /auth/status then reports
# auth_mode=databricks_app_obo. Locally (no headers) it falls back to the
# host+token / profile / service-principal config above.

# --- GenAI codegen (serving endpoint) ---
FOUNDATION_MODEL_PROVIDER=databricks_foundation_model_apis
# Serving endpoint used to generate the app skeleton (queried as the OBO user).
FOUNDATION_MODEL_ENDPOINT=databricks-claude-sonnet
PREFERRED_MODEL=claude
FALLBACK_MODEL=databricks-gpt-fallback

# --- MCP integration (optional; empty = disabled, heuristic discovery) ---
# Prefer a Databricks Managed MCP endpoint (trailing /api/mcp/ is required):
#   https://<app-url>.databricksapps.com/api/mcp/
MCP_SERVER_URL=
# Comma-separated Genie space ids to consider for reuse decisions.
MCP_GENIE_SPACE_IDS=
# Optional Unity Catalog schema scope for table verification.
MCP_UC_SCHEMA=

APPGEN_DIR=.appgen
OUTPUT_ROOT=./generated_apps
DRY_RUN_DEFAULT=true
